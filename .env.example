# ===== חובה =====
BOT_TOKEN=123456:ABC-from-BotFather
# מזהה טלגרם מספרי שלך (אפשר כמה, מופרדים בפסיק). קבל מ-@userinfobot
ADMIN_IDS=111111111
# מצפין את מפתחות ה-API במסד. מחרוזת אקראית ארוכה. אל תאבד אותה!
SECRET_KEY=change-me-to-a-long-random-string
# הכתובת הציבורית של השרת, בלי / בסוף
PUBLIC_URL=https://your-app.onrender.com

# ===== אופציונלי =====
# true = כל משתמש טלגרם יכול לחפש ולדבר עם ה-AI. false = רק אדמינים + ALLOWED_USER_IDS
ALLOW_PUBLIC=false
ALLOWED_USER_IDS=
DATABASE_PATH=data/hub.db
# copy = מעתיק את ההודעה המקורית (הכי יציב, בלי הגבלת גודל) | document = שולח כקובץ
SEND_MODE=copy
# כמה הודעות אחרונות נשמרות כהקשר ל-AI (חוסך טוקנים)
CHAT_CONTEXT_MESSAGES=10
AI_TIMEOUT_SECONDS=45
# לאפליקציית APK אפשר להשאיר *
CORS_ORIGINS=*

# הזרעת מפתחות בהפעלה ראשונה (לא חובה, אפשר להוסיף מהאפליקציה)
# פורמט: preset:key,preset:key   למשל: gemini:AIza...,groq:gsk_...
AI_KEYS_SEED=
